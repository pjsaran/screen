# Code style for the whole solution, verified in CI by `dotnet format --verify-no-changes`
# (SPEC §12: formatting is verified in CI, not left to reviewers).

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,targets,yml,yaml}]
indent_size = 2

[*.cs]
# Namespaces match folders; one type per file; file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_namespace_match_folder = true:warning

# Prefer clarity over brevity: explicit types except where the type is apparent.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression preferences that keep code readable for a newcomer.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_prefer_braces = true:error
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_readonly_field = true:warning

# Usings: System first, outside the namespace.
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# Naming: interfaces start with I, private fields with _camelCase, constants PascalCase.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Documentation: public types and members carry doc comments (SPEC §12).
dotnet_diagnostic.CS1591.severity = none  # enabled per-project once XML docs are turned on

[tests/**.cs]
# Test method names are sentences (Underscores_between_words) and self-documenting;
# doc-comment and naming style rules relax accordingly.
dotnet_diagnostic.CA1707.severity = none
