<!--
  Captr.Cli — the console launcher "captr.exe" (SPEC §4 permits "a small launcher or
  the same executable under a second name"; we use a separate tiny console exe because
  a WinExe cannot serve stdout/stderr/exit codes to a console or Task Scheduler).
  It contains only Program.cs — every command's real logic lives in Captr.Core so it
  is unit-testable and shared with the UI.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Captr.Cli</AssemblyName>
    <!-- The apphost is renamed to captr.exe at publish time (build.ps1): the managed
         assembly must NOT be named 'captr' because Captr.dll and captr.dll are the
         same file on Windows' case-insensitive filesystem and the CLI would
         overwrite the WPF app's assembly in the shared install folder. -->
    <RootNamespace>Captr.Cli</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Captr.Core\Captr.Core.csproj" />
  </ItemGroup>

</Project>
