<ui:FluentWindow
    x:Class="Captr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    Title="Captr"
    Width="1080" Height="720"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Captr" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavigationList" Grid.Column="0" Margin="8"
                     BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnNavigationChanged">
                <ListBoxItem Content="Status" IsSelected="True" />
                <ListBoxItem Content="Recordings" />
                <ListBoxItem Content="Delivery" />
                <ListBoxItem Content="Settings" />
                <ListBoxItem Content="Diagnostics" />
            </ListBox>

            <!-- Frame, not ContentControl: WPF Pages may only parent to a Window or
                 Frame. Navigation chrome and the back-stack are disabled — the nav
                 list on the left is the only navigation. -->
            <Frame x:Name="PageHost" Grid.Column="1"
                   NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" />
        </Grid>

        <!-- The tray icon lives with the window but outlives its visibility:
             closing the window hides to tray (SPEC §9). -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Captr — idle"
            TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Captr" Click="OnTrayOpen" />
                    <Separator />
                    <MenuItem Header="Start recording" Click="OnTrayStart" />
                    <MenuItem Header="Pause" Click="OnTrayPause" />
                    <MenuItem Header="Resume" Click="OnTrayResume" />
                    <MenuItem Header="Stop" Click="OnTrayStop" />
                    <Separator />
                    <MenuItem Header="Quit" Click="OnTrayQuit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
