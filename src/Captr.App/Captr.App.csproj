<!--
  Captr.App — the single Windows executable "Captr.exe" serving two roles (SPEC §4):
  run bare it is the WPF desktop UI (a pure *view* of the host's state); run with the
  host switch it is the headless recording host (no window, owns all recording).
  One assembly, one signature, one install payload. Program.cs performs the role switch.
  (XML comments cannot contain a double hyphen, hence "the host switch" above.)
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Captr.App</AssemblyName>
    <!-- NOT 'Captr': the CLI ships beside us as captr.exe, and Captr.exe/captr.exe
         are the SAME file on Windows' case-insensitive filesystem. -->
    <RootNamespace>Captr.App</RootNamespace>
    <!-- We supply our own Main (role switch) instead of WPF's generated one. -->
    <StartupObject>Captr.App.Program</StartupObject>
    <!-- Per-monitor-v2 DPI awareness (SPEC §6, DPI row). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The application icon: shown on the exe in Explorer, in Alt-Tab, on the
         window's title bar, and by Programs and Features (the installer points at
         this same exe). Generated by build/make-icons.ps1. -->
    <ApplicationIcon>Assets\captr.ico</ApplicationIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF removes System.IO from the implicit usings because Shapes.Path clashes
         with IO.Path; we use no XAML shapes, so bring the IO namespace back. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icons are embedded as resources so the tray can swap between them at
         runtime without shipping loose files next to the executable. -->
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Captr.Core\Captr.Core.csproj" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

</Project>
