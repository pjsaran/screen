<Page
    x:Class="Captr.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:theme="clr-namespace:Captr.App.Theme"
    xmlns:views="clr-namespace:Captr.App.Views"
    Title="Home">
    <!--
        The home page answers three questions, in the order people ask them:
        1. What is it doing right now, and can I act on it?   (the hero card)
        2. Is the recording actually any good?                (the fact strip)
        3. What is being captured?                            (the display previews)
    -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The transport buttons live HERE, not in the card below: they act on the
             whole recorder rather than on one row, which makes them page-level
             actions, and every page's page-level actions belong in the header. -->
        <views:PageHeader Grid.Row="0" Title="Home">
            <views:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Style="{StaticResource ActionButton}" Content="Start recording"
                               Appearance="Primary" Command="{Binding StartCommand}"
                               Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button Style="{StaticResource ActionButton}" Content="Pause" Margin="6,0,0,0"
                               Command="{Binding PauseCommand}"
                               Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Style="{StaticResource ActionButton}" Content="Resume" Appearance="Primary"
                               Margin="6,0,0,0" Command="{Binding ResumeCommand}"
                               Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Style="{StaticResource ActionButton}" Content="Stop" Margin="6,0,0,0"
                               Appearance="Danger" Command="{Binding StopCommand}"
                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </views:PageHeader.Actions>
        </views:PageHeader>

        <!-- ==== Hero: what the recorder is doing, and for how long ============= -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="{Binding StateBrush}" />
                        <TextBlock theme:Typo.Text="{Binding StateText}" Style="{StaticResource DisplayText}"
                                   Foreground="{Binding StateBrush}" />
                    </StackPanel>

                    <!-- The elapsed clock is the one number worth reading from across
                         the room, so it gets its own line at display size. -->
                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource DisplayText}"
                               FontFamily="{StaticResource MonoFont}" Margin="20,6,0,0"
                               Visibility="{Binding ElapsedText, Converter={StaticResource NonEmptyToVisibility}}" />

                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" Margin="20,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==== Messages: only present when there is something to say =========== -->
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="12,10"
                    Background="{StaticResource CautionTintBrush}"
                    BorderBrush="{StaticResource CautionEdgeBrush}"
                    Visibility="{Binding WarningText, Converter={StaticResource NonEmptyToVisibility}}">
                <TextBlock Text="{Binding WarningText}" Style="{StaticResource WarningText}" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,10"
                    Background="{StaticResource CriticalTintBrush}"
                    BorderBrush="{StaticResource CriticalEdgeBrush}"
                    Visibility="{Binding LastError, Converter={StaticResource NonEmptyToVisibility}}">
                <TextBlock Text="{Binding LastError}" Style="{StaticResource ErrorText}" />
            </Border>
        </StackPanel>

        <!-- ==== Fact strip: four numbers that matter, side by side ============= -->
        <Border Grid.Row="3" Style="{StaticResource Card}"
                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
            <UniformGrid Rows="1" Columns="4">
                <StackPanel>
                    <TextBlock theme:Typo.Text="Coverage" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text="{Binding CoverageText}" Style="{StaticResource TitleText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CoverageHint}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock theme:Typo.Text="Encoder" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text="{Binding EncoderText}" Style="{StaticResource TitleText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding EncoderHint}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock theme:Typo.Text="Capture" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text="{Binding CaptureText}" Style="{StaticResource TitleText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CaptureHint}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock theme:Typo.Text="Disk" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource TitleText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding DiskHint}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ==== Display previews =============================================== -->
        <!-- Top-aligned, so the card is as tall as its contents rather than stretching
             to the bottom of the window. A card that filled the page here and hugged
             its content on every other page was the last thing that visibly moved
             when switching between them. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock theme:Typo.Text="What is being captured" Style="{StaticResource MicroLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplaysHint}" Style="{StaticResource CaptionText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" MaxHeight="420"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Margin="0,0,8,8" Padding="6">
                                    <StackPanel Width="208">
                                        <!-- A fixed 16:9 frame keeps the grid tidy while a
                                             preview is still being captured or has failed. -->
                                        <Border Width="196" Height="110" CornerRadius="4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}"
                                                   Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                                   Margin="2,1,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
