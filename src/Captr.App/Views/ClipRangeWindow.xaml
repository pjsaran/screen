<Window
    x:Class="Captr.App.Views.ClipRangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Extract clip"
    Width="520" Height="420" WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                   Text="Choose the first and last segment to keep. Clips are cut at segment boundaries and copied without re-encoding, so extraction is fast and the picture is identical to the original." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="90" IsCancel="True" />
            <Button x:Name="ExtractButton" Content="Extract" MinWidth="90" Margin="8,0,0,0"
                    IsDefault="True" Click="OnExtractClicked" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="From segment:" VerticalAlignment="Center" />
            <TextBox x:Name="FromBox" Grid.Column="1" Margin="8,0" />
            <TextBlock Grid.Column="2" Text="To segment:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="ToBox" Grid.Column="3" Margin="8,0" />
        </Grid>

        <ListView x:Name="SegmentList" Margin="0,12,0,0" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}" />
                    <GridViewColumn Header="Starts at" Width="110" DisplayMemberBinding="{Binding StartText}" />
                    <GridViewColumn Header="Length" Width="110" DisplayMemberBinding="{Binding DurationText}" />
                    <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding FileName}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
