<Application
    x:Class="Captr.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- No StartupUri: Program.cs owns startup so the host role never touches WPF. -->
    <Application.Resources>
        <ResourceDictionary xmlns:views="clr-namespace:Captr.App.Views">
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF UI theme resources: system theme + accent (SPEC §9). -->
                <ui:ThemesDictionary Theme="Unknown" />
                <ui:ControlsDictionary />
                <!-- Captr's own design system, layered on top: typography, spacing,
                     cards, pills, navigation. Every page draws from it. -->
                <ResourceDictionary Source="pack://application:,,,/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <views:EmptyStringToVisibilityConverter x:Key="NonEmptyToVisibility" />
            <views:CountToVisibilityConverter x:Key="CountToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
