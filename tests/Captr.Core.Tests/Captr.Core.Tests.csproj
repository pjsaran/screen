<!--
  Unit tests: fast, deterministic, no FFmpeg, no real hardware, no real display APIs.
  Anything that needs a real process, disk timing, or a GPU belongs in
  Captr.Integration.Tests instead.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Captr.Core.Tests</RootNamespace>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform; this opts `dotnet test` into it
         (the legacy VSTest path no longer exists on the .NET 10 SDK). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every test file uses xunit attributes; import the namespace once. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Captr.Core\Captr.Core.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
