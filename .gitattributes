# ============================================================================
# Line endings are decided HERE, once, for everybody — not by whatever
# core.autocrlf each machine happens to have.
#
# WHY THIS FILE EXISTS. .editorconfig requires `end_of_line = crlf`, and
# `dotnet format --verify-no-changes` enforces it in CI and in build/build.ps1.
# Without this file, what lands in your working tree depends on a per-machine
# git setting: a clone on a machine with core.autocrlf=true gets CRLF and
# passes, and a clone on a machine with core.autocrlf=false gets LF and fails
# — measured, on this repository, at 23,604 ENDOFLINE errors on a clean clone.
# The developer who hits it has done nothing wrong and has no way to tell that
# from a real formatting mistake, so they run `dotnet format`, which rewrites
# every file in the repository and turns a config gap into an enormous diff.
#
# `text=auto` keeps LF in the object store (which is what is already committed,
# so adding this file causes NO re-normalisation churn); `eol=crlf` makes every
# checkout produce CRLF regardless of local git config. Windows-only product,
# Windows-only line endings.
# ============================================================================
* text=auto eol=crlf

# Shell scripts must keep LF or they will not run under sh. There are none in
# the tree today; this is here so that adding one cannot silently break it.
*.sh text eol=lf

# Explicitly binary. Git's content heuristic gets these right today, but a
# heuristic that guesses wrong on a .ico corrupts it with line-ending
# translation, and the corruption survives into the installer.
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.pfx  binary
*.snk  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# Recorded footage is binary and must never be line-ending translated. These
# are also gitignored; this is the second line of defence for a stray -f add.
*.mkv binary
*.mp4 binary

# Golden argument files are regenerated by the tests themselves
# (CAPTR_ACCEPT_GOLDEN=1), which writes "\n". Pinning them to LF keeps a
# regenerated file byte-identical to a checked-out one, so regeneration shows a
# diff only when the ARGUMENTS actually changed — which is the entire point of
# a golden file.
*.args.txt text eol=lf

# Collapse the noise in review for files nobody edits by hand.
build/licenses/THIRD-PARTY.md linguist-generated=true
